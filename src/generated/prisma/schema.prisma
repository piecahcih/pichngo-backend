// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  firebase_uid String?  @unique
  name         String?
  email        String   @unique
  password     String
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @db.Timestamp(0)
  profileImg   String?

  bookings Booking[]
  likes    Like[]
  rewards  Rewards[]
  reviews  Reviews[]
  travlers TravelerInfo[]

  @@map("User")
}

model TravelerInfo {
  id        Int     @id @default(autoincrement())
  firstName String?
  lastName  String?

  user   User? @relation(fields: [userId], references: [id])
  userId Int

  @@map("TravelerInfo")
}

model Hotel {
  id   Int    @id @default(autoincrement())
  name String

  hotelImg   HotelImg @relation(fields: [hotelImgId], references: [id])
  hotelImgId Int

  hotelDetails  String
  address       String
  city          String
  country       String
  surroundings  String
  amenities     String
  policies      String
  reviewCount   Int?
  averageRating Float?
  latitude      Float
  longitude     Float

  rooms     Room[]
  likes     Like[]
  reviews   Reviews[]
  discounts Discount[]

  @@map("Hotel")
}

model HotelImg {
  id   Int     @id @default(autoincrement())
  img1 String?
  img2 String?
  img3 String?
  img4 String?

  hotel Hotel[]

  @@map("HotelImg")
}

model Room {
  id          Int    @id @default(autoincrement())
  roomType    String
  roomImg     String
  nightlyRate Int

  roomAmount Int @default(1)

  maxAdults   Int @default(2)
  maxChildren Int @default(0)

  bedSetup  String?
  roomSize  Int?
  isSmoking Boolean @default(false)

  hotel   Hotel @relation(fields: [hotelId], references: [id])
  hotelId Int

  bookings Booking[]
  reviews  Reviews[]

  @@map("Room")
}

model Like {
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  hotelId   Int
  createdAt DateTime @default(now()) @db.Timestamp(0)

  @@id([userId, hotelId])
  @@map("Like")
}

model Booking {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id])
  userId Int

  room       Room @relation(fields: [roomId], references: [id])
  roomId     Int
  roomAmount Int  @default(1)

  numGuest      Int
  checkInDate   DateTime      @db.Date
  checkOutDate  DateTime      @db.Date
  bookingDate   DateTime      @default(now()) @db.Timestamp(0)
  bookingStatus bookingStatus @default(WAITING)

  originalPrice  Decimal   @db.Decimal(10, 2)
  discountAmount Decimal?  @db.Decimal(10, 2)
  taxesAndFees   Decimal   @default(0) @db.Decimal(10, 2)
  finalPrice     Decimal   @db.Decimal(10, 2)
  discount       Discount? @relation(fields: [discountId], references: [id])
  discountId     Int?

  payment       Payment[]
  rewards       Rewards[]
  bookingGuests BookingGuest[]

  @@map("Booking")
}

model BookingGuest {
  id        Int    @id @default(autoincrement())
  firstName String
  lastName  String

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId Int

  @@map("BookingGuest")
}

enum bookingStatus {
  WAITING
  CONFIRMED
  CANCELLED
}

model Discount {
  id            Int          @id @default(autoincrement())
  code          String       @unique
  description   String
  discountImage String
  value         Float
  type          DiscountType @default(PERCENTAGE)

  minSpend    Float?
  maxDiscount Float?

  startDate DateTime? @default(now())
  endDate   DateTime?

  usageLimit Int?
  usedCount  Int     @default(0)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
  hotels   Hotel[]

  @@map("Discount")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PaymentMethod {
  CREDIT_CARD
  BANK_TRANSFER
  QR_PAYMENT
}

enum PaymenStatus {
  UNPAID
  PAID
}

model Payment {
  id Int @id @default(autoincrement())

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId Int

  paymentMethod PaymentMethod
  bankName      String?
  accountNo     String?
  accountName   String
  amount        Float
  paymentDate   DateTime
  paymentRefNo  String
  paymentStatus PaymenStatus

  @@map("Payment")
}

model Reviews {
  id Int @id @default(autoincrement())

  user    User  @relation(fields: [userId], references: [id])
  userId  Int
  hotel   Hotel @relation(fields: [hotelId], references: [id])
  hotelId Int
  room    Room  @relation(fields: [roomId], references: [id])
  roomId  Int

  reviewContent String
  reviewImg     String?
  rating        Int
  stayedDate    DateTime

  @@map("Reviews")
}

model Rewards {
  id           Int          @id @default(autoincrement())
  rewardPoints Int
  rewardStatus RewardStatus @default(PENDING)

  user      User    @relation(fields: [userId], references: [id])
  userId    Int
  booking   Booking @relation(fields: [bookingId], references: [id])
  bookingId Int     @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Rewards")
}

enum RewardStatus {
  PENDING
  AVAILABLE
  CANCELLED
}
